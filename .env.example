# 복사해서 .env.local 을 만든다.  .env.local 은 커밋하지 않는다.
# 자세한 설명: stack.md §3

# ── Supabase ────────────────────────────────────────────────
# Supabase 프로젝트 > Settings > API 에서 복사
SUPABASE_URL=
# 🔴 서버 전용. 절대 NEXT_PUBLIC_ 접두사를 붙이지 않는다 (RLS 우회 키)
SUPABASE_SERVICE_ROLE_KEY=

# ── Claude API ──────────────────────────────────────────────
# 🔴 서버 전용. 카드 생성(배치) · 근거 검색에만 쓴다
ANTHROPIC_API_KEY=

# ── 관리자 검수 화면 (/admin) ────────────────────────────────
# 🔴 서버 전용. 조원끼리 공유하는 비밀번호 1개 (adr.md ADR-006)
ADMIN_PASSWORD=

# ── Vercel Cron ─────────────────────────────────────────────
# 🔴 서버 전용. 아무 긴 랜덤 문자열
CRON_SECRET=

# ── 공개 (유일하게 NEXT_PUBLIC_ 이 붙는 값) ──────────────────
# QR 코드에 넣을 주소. 로컬은 http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
